# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Override the Gemini model. Defaults to gemini-2.5-flash (stable).
# Avoid -preview models in production — their pricing/availability can change.
# GEMINI_MODEL="gemini-2.5-flash"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform.
# Get one at: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_KEY"

# VITE_DEMO_AI_PASSWORD: Soft demo gate password for GitHub Pages builds.
# Store the real value in GitHub Repository secrets, not in source code.
VITE_DEMO_AI_PASSWORD="MY_DEMO_PASSWORD"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
